# Example local configuration for the PII Firewall project.
# Copy this file to `.env` and adjust values.

# -----------------------------
# Master key for AES-256-GCM
# -----------------------------
# Must be at least 32 bytes when UTF-8 encoded.
# In real deployments, use a long random string (or a key from a secrets manager).
PII_FIREWALL_KEY=change-me-to-a-long-random-string-32-bytes-min

# Optionally, default provider hint (used by /whoami)
# PII_FIREWALL_DEFAULT_PROVIDER=openai


# -----------------------------
# OpenAI / ChatGPT (optional)
# -----------------------------
# Required for provider="openai"
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override default model
# OPENAI_MODEL=gpt-4o-mini
# Optional: override base URL (for proxies / self-hosted)
# OPENAI_BASE_URL=https://api.openai.com/v1


# -----------------------------
# Anthropic / Claude (optional)
# -----------------------------
# Required for provider="anthropic"
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override model
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Optional: override base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1


# -----------------------------
# Google / Gemini (optional)
# -----------------------------
# Required for provider="google"
# GEMINI_API_KEY=your-gemini-key-here
# Optional: override model
# GEMINI_MODEL=gemini-1.5-flash
# Optional: override base URL
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------
# DeepSeek (optional)
# -----------------------------
# Required for provider="deepseek"
# DEEPSEEK_API_KEY=your-deepseek-key-here
# Optional: override model
# DEEPSEEK_MODEL=deepseek-chat
# Optional: override base URL
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
